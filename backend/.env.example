# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
# Para desenvolvimento local, use estas variáveis individuais:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tech_challenge_blog
DB_USER=admin
DB_PASSWORD=password123

# Para produção (Render, Railway, etc), use DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Opcional: Use Docker secrets em produção
# DB_PASSWORD_FILE=/run/secrets/db_password

# JWT Configuration
# IMPORTANTE: Gere secrets fortes com pelo menos 32 caracteres
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another-super-secret-different-from-jwt-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Opcional: Use Docker secrets em produção
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret

# Password hashing
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30

# AWS S3 Configuration
# Obtenha estas credenciais no AWS IAM Console
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=tech-challenge-blog-uploads
AWS_REGION=us-east-1

# Upload Configuration
# MAX_FILE_SIZE em bytes (5242880 = 5MB)
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/gif

# CORS Configuration
# Para desenvolvimento local:
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Para produção (separe múltiplas origens por vírgula):
# CORS_ALLOWED_ORIGINS=https://seu-app.vercel.app,https://staging.seu-app.vercel.app