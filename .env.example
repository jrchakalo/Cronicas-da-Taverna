# Este arquivo é usado pelo Docker Compose
# Para desenvolvimento local sem Docker, use backend/.env.example

# Database Configuration
DB_NAME=cronicas_da_taverna
DB_USER=admin
DB_PASSWORD=change-me-in-production

# Use DATABASE_URL em produção (Render/Railway/etc)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Opcional: Use Docker secrets para maior segurança
# DB_PASSWORD_FILE=/run/secrets/db_password

# JWT Configuration
# IMPORTANTE: Gere secrets fortes com pelo menos 32 caracteres
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-generate-secure-random-string-min-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-another-secure-random-different-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Opcional: Use Docker secrets
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret

# Password hashing
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30

# AWS S3 Configuration
# Obtenha estas credenciais no AWS IAM Console
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=tech-challenge-uploads
AWS_REGION=us-east-1